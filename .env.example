# In-Depth Quant Stock Analyzer — environment template
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Alpha Vantage (free tier: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep (free tier: https://site.financialmodelingprep.com/developer/docs)
FMP_API_KEY=

# SEC EDGAR — NOT a secret API key. SEC public endpoints require a User-Agent header
# identifying the requester: "Sample CompanyName AdminContact@sample.com"
# See: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Optional backend configuration (no secrets)
# QUANT_DB_PATH=backend/data/quant.db
# RISK_FREE_RATE=0.04
